---
// src/components/sections/Conferences.astro
import Container from '../Container.astro';
import { conferences } from '../../data/content';

// Sort / filter: conferences are the first 3 entries, workshops are the last 2 entries
const confEntries = conferences.slice(0, 3);
const workshopEntries = conferences.slice(3, 5);
---

<div class="space-y-12">
      <!-- Subsection Heading -->
      <div class="space-y-3">
        <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Conferences & Presentations
        </h3>
        <div class="h-1.5 w-16 bg-gradient-to-r from-violet-600 to-indigo-600 dark:from-violet-400 dark:to-indigo-400 rounded-full"></div>
      </div>

      <div class="space-y-10">
        <!-- Conferences Sub-section -->
        <div class="space-y-6">
          <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-violet-600 dark:bg-violet-400"></span>
            Conference Presentations
          </h3>
          <div class="grid grid-cols-1 gap-6">
            {confEntries.map((entry) => (
              <div class="glass-panel p-6 rounded-2xl space-y-4 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex flex-col sm:flex-row justify-between sm:items-start gap-4">
                  <div class="space-y-1">
                    <h4 class="text-lg font-bold text-slate-900 dark:text-white leading-snug">{entry.event}</h4>
                    <p class="text-sm font-semibold text-slate-500 dark:text-slate-300">{entry.location}</p>
                  </div>
                  <span class="px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 self-start border border-slate-200/50 dark:border-slate-700 shrink-0">
                    {entry.dates}
                  </span>
                </div>

                {entry.paperTitle && (
                  <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-2">
                    <p class="text-sm sm:text-base font-medium text-slate-800 dark:text-slate-200">
                      Paper: <span class="italic">"{entry.paperTitle}"</span>
                    </p>
                    {entry.authors && (
                      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-300">
                        Authors: {entry.authors}
                      </p>
                    )}
                    {entry.isBestPaper && (
                      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-semibold bg-emerald-100 dark:bg-emerald-950/30 text-emerald-800 dark:text-emerald-300 border border-emerald-200/50 dark:border-emerald-900/50">
                        <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                        </svg>
                        Selected Best Paper & Poster Presentation
                      </div>
                    )}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>

        <!-- Workshops Sub-section -->
        <div class="space-y-6">
          <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-violet-600 dark:bg-violet-400"></span>
            Workshops & Summer Schools
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {workshopEntries.map((entry) => (
              <div class="glass-panel p-6 rounded-2xl flex flex-col justify-between gap-4 shadow-sm hover:shadow-md transition-shadow">
                <div class="space-y-2">
                  <h4 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white leading-snug">{entry.event}</h4>
                  <p class="text-xs sm:text-sm font-semibold text-slate-500 dark:text-slate-300">{entry.location}</p>
                </div>
                <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-semibold text-slate-500 dark:text-slate-300">
                  <span>Date</span>
                  <span class="text-violet-600 dark:text-violet-400">{entry.dates}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </div>
