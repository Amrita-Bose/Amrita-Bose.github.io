---
// src/components/sections/ResearchInterests.astro
import Container from '../Container.astro';
import { researchInterests } from '../../data/content';
---

<section id="research-interests" class="py-16 sm:py-24 bg-transparent transition-colors duration-300 reveal-on-scroll">
  <Container>
    <div class="space-y-8">
      <div class="space-y-3">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white">
          Research Interests
        </h2>
        <div class="h-1.5 w-16 bg-gradient-to-r from-violet-600 to-indigo-600 dark:from-violet-400 dark:to-indigo-400 rounded-full"></div>
      </div>

      <div class="flex flex-wrap gap-3 sm:gap-4 max-w-3xl">
        {researchInterests.map((interest) => (
          <div class="px-5 py-3 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 text-slate-800 dark:text-slate-200 font-semibold text-sm sm:text-base shadow-sm hover:border-violet-500 dark:hover:border-violet-400 hover:shadow-md transition-all duration-200 flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-violet-600 dark:bg-violet-400"></span>
            {interest}
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
