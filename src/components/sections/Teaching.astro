---
// src/components/sections/Teaching.astro
import Container from '../Container.astro';
import { teaching } from '../../data/content';
import SectionHeader from '../SectionHeader.astro';
---

<section id="teaching" class="py-16 sm:py-24 bg-transparent transition-colors duration-300 reveal-on-scroll">
  <Container>
    <div class="space-y-12">
      <SectionHeader title="Teaching Assistantship" />

      <!-- Teaching Roles List -->
      <div class="space-y-6">
        {teaching.map((entry) => (
          <div class="glass-panel p-6 rounded-2xl space-y-4 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                {entry.course}
              </h3>
              {(entry.semester || entry.session) && (
                <span class="inline-flex px-3 py-1 rounded-full text-xs font-semibold bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-300 border border-violet-200/50 dark:border-violet-800 self-start sm:self-center">
                  {entry.semester || entry.session}
                </span>
              )}
            </div>

            <div class="space-y-2 text-sm sm:text-base text-slate-600 dark:text-slate-300">
              {entry.department && (
                <p>
                  <span class="font-semibold text-slate-800 dark:text-slate-300">Department:</span> {entry.department}
                </p>
              )}
              {entry.description && (
                <p class="mt-2 bg-slate-50/50 dark:bg-slate-900/50 p-4 rounded-xl border border-slate-100 dark:border-slate-800 text-slate-600 dark:text-slate-300">
                  {entry.description}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
