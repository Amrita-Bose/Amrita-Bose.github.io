---
// src/components/sections/About.astro
import Container from '../Container.astro';
import SectionHeader from '../SectionHeader.astro';
import { personal, researchInterests } from '../../data/content';

const hasBio = personal && personal.researchTagline;
---

<section id="about" class="py-16 sm:py-24 bg-transparent transition-colors duration-300 reveal-on-scroll">
  <Container>
    <div class="space-y-12">
      <!-- Section Header -->
      <SectionHeader title="About" />

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16">
        <!-- Bio Column -->
        <div class="lg:col-span-2 space-y-6">
          {hasBio ? (
            <>
              <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
                Amrita Bose is a doctoral researcher in cryptography and security. At present, her Ph.D. research focuses on identifying and mitigating security vulnerabilities in the healthcare domain, particularly emphasizing implantable and wearable medical devices and the associated environment.
              </p>
              <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
                During her Master's (M.S.) at IIT Kharagpur, she worked extensively in the area of cryptanalysis using machine learning techniques. Prior to starting her academic journey at IIT Kharagpur, she gained valuable industry experience working as an Application Developer (Associate IT Consultant at ITC Infotech).
              </p>
            </>
          ) : (
            <div class="p-6 rounded-2xl bg-red-50 dark:bg-red-950/20 border border-red-200 dark:border-red-900/50 text-red-700 dark:text-red-400 text-sm">
              Biography content could not be loaded. Please ensure CV data is populated.
            </div>
          )}
        </div>

        <!-- Research Interests Column -->
        <div class="space-y-5">
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-teal-500 dark:bg-teal-400"></span>
            Research Interests
          </h3>
          <div class="flex flex-wrap gap-2.5">
            {researchInterests.map((interest) => (
              <div class="px-4 py-2.5 rounded-2xl bg-white/70 dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-800/80 text-slate-800 dark:text-slate-200 font-semibold text-xs sm:text-sm shadow-sm hover:border-violet-500 dark:hover:border-violet-400 hover:shadow-md transition-all duration-200 flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-violet-600 dark:bg-violet-400"></span>
                {interest}
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </Container>
</section>
