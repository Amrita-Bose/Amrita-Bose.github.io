---
// src/components/sections/Experience.astro
import Container from '../Container.astro';
import { industryExperience, researchExperience, teaching } from '../../data/content';
import SectionHeader from '../SectionHeader.astro';
---

<section id="experience" class="py-16 sm:py-24 bg-transparent transition-colors duration-300 reveal-on-scroll">
  <Container>
    <div class="space-y-12">
      <SectionHeader title="Experience" />

      <div class="grid grid-cols-1 gap-10">
        <!-- 1. Teaching Assistant Subsection (ends Spring 2026) -->
        <div class="space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-violet-600 dark:bg-violet-400"></span>
              Teaching Assistant
            </h3>
            <p class="text-xs sm:text-sm text-violet-600 dark:text-violet-400 font-medium">
              Note: See the <a href="#teaching" class="underline hover:text-violet-700 dark:hover:text-violet-300 focus:outline-none">Teaching Section</a> for full details.
            </p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {teaching.map((ta) => (
              <div class="glass-panel p-5 rounded-2xl space-y-3 flex flex-col justify-between">
                <h4 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">{ta.course}</h4>
                <div class="pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-semibold text-slate-500 dark:text-slate-300">
                  <span>Semester / Session</span>
                  <span class="text-violet-600 dark:text-violet-400">{ta.semester || ta.session}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- 2. Junior Research Fellowship Subsection (ends June 2024) -->
        <div class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-violet-600 dark:bg-violet-400"></span>
            Junior Research Fellowship
          </h3>
          <div class="space-y-4">
            {researchExperience.map((exp) => (
              <div class="glass-panel p-5 rounded-2xl flex flex-col sm:flex-row justify-between sm:items-start gap-4">
                <div class="space-y-1">
                  <h4 class="text-lg font-bold text-slate-900 dark:text-white">{exp.role}</h4>
                  <p class="text-sm sm:text-base font-semibold text-slate-700 dark:text-slate-300">{exp.employer}</p>
                </div>
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 self-start border border-slate-200/50 dark:border-slate-700">
                  {exp.period}
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- 3. Industry Experience Subsection (ends October 2021) -->
        <div class="space-y-4">
          <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-violet-600 dark:bg-violet-400"></span>
            Industry Experience
          </h3>
          <div class="space-y-4">
            {industryExperience.map((exp) => (
              <div class="glass-panel p-5 rounded-2xl flex flex-col sm:flex-row justify-between sm:items-start gap-4">
                <div class="space-y-1">
                  <h4 class="text-lg font-bold text-slate-900 dark:text-white">{exp.role}</h4>
                  <p class="text-sm sm:text-base font-semibold text-slate-700 dark:text-slate-300">{exp.employer}</p>
                </div>
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 self-start border border-slate-200/50 dark:border-slate-700">
                  {exp.period}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
