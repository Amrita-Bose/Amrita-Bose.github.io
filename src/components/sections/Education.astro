---
// src/components/sections/Education.astro
import Container from '../Container.astro';
import { education } from '../../data/content';

import SectionHeader from '../SectionHeader.astro';

// Sort in reverse-chronological order (PhD first, then MS, then B.Tech)
const sortedEducation = [...education].sort((a, b) => a.order - b.order);
---

<section id="education" class="py-16 sm:py-24 bg-transparent transition-colors duration-300 reveal-on-scroll">
  <Container>
    <div class="space-y-12">
      <SectionHeader title="Education" />

      <!-- Timeline container with scroll-linked progress line -->
      <div class="relative ml-3 sm:ml-6 space-y-12 py-2" data-timeline-container>
        <!-- Background track line -->
        <div class="absolute left-0 top-0 bottom-0 w-0.5 bg-slate-200 dark:bg-slate-800 z-0"></div>
        <!-- Scroll-progress indicator line -->
        <div class="absolute left-0 top-0 w-0.5 bg-gradient-to-b from-violet-600 to-indigo-500 dark:from-violet-400 dark:to-indigo-500 z-0 origin-top scale-y-0 transition-transform duration-100 ease-out" data-timeline-progress></div>

        {sortedEducation.map((entry) => (
          <div class="relative pl-8 sm:pl-10 z-10">
            <!-- Timeline Marker (Dot) -->
            <span data-timeline-dot class="absolute -left-[10px] top-1.5 flex h-5 w-5 items-center justify-center rounded-full bg-slate-300 dark:bg-slate-700 ring-4 ring-white dark:ring-slate-950 transition-all duration-300">
              <span class="h-2 w-2 rounded-full bg-white transition-all duration-300"></span>
            </span>

            <!-- Content Card -->
            <div class="glass-panel p-5 sm:p-6 rounded-2xl space-y-4 shadow-sm hover:shadow-md transition-shadow">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="space-y-1">
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white">
                    {entry.degree}
                  </h3>
                  <p class="text-sm sm:text-base font-semibold text-slate-700 dark:text-slate-300">
                    {entry.institution}
                  </p>
                </div>
                <span class="inline-flex px-3 py-1 rounded-full text-xs font-semibold bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-300 self-start sm:self-center border border-violet-200/50 dark:border-violet-800">
                  {entry.years}
                </span>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-3 border-t border-slate-100 dark:border-slate-800 text-sm sm:text-base text-slate-600 dark:text-slate-300">
                {entry.advisor && (
                  <div>
                    <span class="font-semibold text-slate-800 dark:text-slate-300">Advisor/Supervisor:</span>
                    <p>{entry.advisor}</p>
                  </div>
                )}
                {entry.thesis && (
                  <div class="md:col-span-2">
                    <span class="font-semibold text-slate-800 dark:text-slate-300">Thesis:</span>
                    <p class="italic text-slate-700 dark:text-slate-300">{entry.thesis}</p>
                  </div>
                )}
                {entry.project && (
                  <div class="md:col-span-2">
                    <span class="font-semibold text-slate-800 dark:text-slate-300">Final Year Project:</span>
                    <p class="italic text-slate-700 dark:text-slate-300">{entry.project}</p>
                  </div>
                )}
                {entry.cgpa && (
                  <div>
                    <span class="font-semibold text-slate-800 dark:text-slate-300">CGPA:</span>
                    <p class="font-medium text-slate-900 dark:text-slate-200">{entry.cgpa}</p>
                  </div>
                )}
                {entry.dgpa && (
                  <div>
                    <span class="font-semibold text-slate-800 dark:text-slate-300">DGPA:</span>
                    <p class="font-medium text-slate-900 dark:text-slate-200">{entry.dgpa}</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
