---
// src/components/sections/AcademicService.astro
import Container from '../Container.astro';
import { academicService } from '../../data/content';
---

<div class="space-y-12">
      <!-- Subsection Heading -->
      <div class="space-y-3">
        <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
          Academic Service
        </h3>
        <div class="h-1.5 w-16 bg-gradient-to-r from-violet-600 to-indigo-600 dark:from-violet-400 dark:to-indigo-400 rounded-full"></div>
      </div>

      <div class="space-y-6">
        <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-violet-600 dark:bg-violet-400"></span>
          Peer Review
        </h3>
        
        {academicService.map((entry) => (
          <div class="glass-panel p-6 rounded-2xl flex flex-col sm:flex-row justify-between sm:items-center gap-4 shadow-sm hover:shadow-md transition-shadow">
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-semibold bg-violet-100 dark:bg-violet-900/30 text-violet-700 dark:text-violet-300 border border-violet-200/50 dark:border-violet-800">
                  {entry.type}
                </span>
                <span class="text-xs text-slate-500 dark:text-slate-300 font-semibold">{entry.year}</span>
              </div>
              <h4 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
                Reviewer for {entry.publication}
              </h4>
            </div>

            <!-- Publons hyperlink target="_blank" (labeled "Publons") -->
            <a
              href={entry.url}
              target="_blank"
              rel="noopener noreferrer"
              class="h-11 px-6 inline-flex items-center justify-center rounded-xl bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 font-semibold text-sm border border-slate-200 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/80 hover:text-violet-600 dark:hover:text-violet-400 hover:border-violet-300 dark:hover:border-violet-800 shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-violet-500 self-start sm:self-center"
            >
              Publons
            </a>
          </div>
        ))}
    </div>
  </div>
